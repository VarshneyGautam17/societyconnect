# Copy this file to .env.local and fill in real values. .env.local is already
# git-ignored (see .gitignore) -- never commit real keys.

# Supabase: Project Settings -> API (after creating a project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary: Dashboard (cloud name) + Settings -> Upload -> Upload presets
# (create one with Signing Mode = Unsigned, note its name)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name

# Your deployed domain (no trailing slash). Used to build absolute URLs for shared links and
# the business-page share poster (opengraph-image) -- without it, those fall back to localhost.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
