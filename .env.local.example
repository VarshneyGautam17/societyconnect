# Copy this file to .env.local and fill in real values. .env.local is already
# git-ignored (see .gitignore) -- never commit real keys.

# Supabase: Project Settings -> API (after creating a project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary: Dashboard (cloud name) + Settings -> Upload -> Upload presets
# (create one with Signing Mode = Unsigned, note its name)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name

# Your deployed domain (no trailing slash). Used to build absolute URLs for shared links and
# the business-page share poster (opengraph-image) -- without it, those fall back to localhost.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# WhatsApp Cloud API: developers.facebook.com -> your app -> WhatsApp -> API Setup.
# Server-only (no NEXT_PUBLIC_ prefix) -- the access token must never reach the browser.
# The API Setup token expires in ~24h; for production generate a permanent one from a
# System User in Business Settings.
WHATSAPP_ACCESS_TOKEN=EAA...your-token...
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
# Name + language code of the approved "Authentication" template used for the resident login
# code (WhatsApp Manager -> Message templates). Until it's set, `next dev` prints the code to the
# terminal instead of sending it; production refuses to send.
WHATSAPP_OTP_TEMPLATE_NAME=your-otp-template-name
WHATSAPP_OTP_TEMPLATE_LANG=en

# Supabase service role key: Project Settings -> API Keys -> "service_role" / "secret" key.
# SERVER-ONLY -- no NEXT_PUBLIC_ prefix. Bypasses RLS; used only by the resident phone-login
# server actions (src/app/access/actions.js, via src/lib/supabase/serviceRole.js).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shows the WhatsApp login gate on resident pages. Leave unset/false until the login template
# above is approved, or every visitor is stuck at a gate that can't send codes.
NEXT_PUBLIC_ACCESS_GATE_ENABLED=false
